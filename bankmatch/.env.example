# Copy to .env and fill in. .env is gitignored — never commit it, never paste
# these values into a chat window.
#
# Gmail / Google Workspace: create an app password at
#   https://myaccount.google.com/apppasswords   (needs 2-step verification on)
# Microsoft 365 / Outlook.com: IMAP_HOST=outlook.office365.com
#
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=your-app-specific-password
